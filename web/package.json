{
  "name": "canada-weather-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web app for downloading historical ECCC weather data as a single CSV.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "stations": "tsx scripts/build-stations.ts",
    "predev": "npm run stations",
    "dev": "vite",
    "prebuild": "npm run stations",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/node.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
