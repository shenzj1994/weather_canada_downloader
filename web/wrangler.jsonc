// Cloudflare Workers deployment (see README "Hosting on Cloudflare").
//   npm run cf:dev    # local preview on http://localhost:8787
//   npm run deploy    # build and deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canada-weather-web",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The UI and stations.json, served by Cloudflare without running the Worker.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // Only API requests run the Worker.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
